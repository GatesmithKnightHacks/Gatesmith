# HTTPS front door (specs/12 §3). SITE_ADDRESS comes from the env file, e.g. 203.0.113.7.sslip.io;
# Caddy obtains and renews the certificate itself (ports 80 and 443 must be open).
{$SITE_ADDRESS} {
	# API: /api/<path> goes to the platform as /<path>, so the platform keeps the endpoint paths of
	# specs/12 §2 (/health, /jobs, ...) and the web app calls them as /api/health, /api/jobs, ...
	handle_path /api/* {
		reverse_proxy platform:8080
	}

	# Everything else: the web app built from web/ (hash routes, so index.html serves every screen).
	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}

	# While the platform container is not running (or restarts), API calls get a clear message.
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		respond "Gatesmith: the platform API is not running yet, or is restarting. Try again shortly." 503
	}
}
