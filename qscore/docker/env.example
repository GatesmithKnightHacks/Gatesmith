# Template for /opt/qscore/.env on the Vultr server (chmod 600). Never commit a filled copy.
# Read by Docker Compose, not by a shell: one KEY=value per line, no quotes, no spaces around '=',
# no comments after a value.

# Public address Caddy serves over HTTPS. bootstrap_vultr.sh fills in <server-ip>.sslip.io.
SITE_ADDRESS=

# Neon connection string for the qscore_platform role, production branch (pooled host is fine).
QSCORE_NEON_DSN=

# Bearer token for the platform's write endpoints (specs/12 §2). Generate: openssl rand -hex 32
QSCORE_PLATFORM_TOKEN=

# Hugging Face token, fine-grained, write access to the qscore-runs dataset only (CP-0006).
HF_TOKEN=

# Tier 2 assistant only (specs/12 §6):
# GEMINI_API_KEY=

# Leave QSCORE_PROFILE unset (dev): no fallback is approved for the demo profile (specs/17).
