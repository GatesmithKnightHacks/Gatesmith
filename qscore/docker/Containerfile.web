# Front door image: the React/Vite app in web/ served by Caddy (specs/12 §3, adapted: the UI is a
# static web app, not Gradio). Build context is the repo root:
#   docker build -f qscore/docker/Containerfile.web .
# The app imports ../../design/tokens.css, so design/ is part of the context too.

FROM node:22-slim AS build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY design /src/design
COPY web ./
RUN npm run build

FROM caddy:2
COPY --from=build /src/web/dist /srv
