# Platform image: FastAPI + Gradio on port 8080 (specs/12 §2-3). Build context is qscore/:
#   docker build -f docker/Containerfile.platform .
# The engine package is installed with the `ui` extra from the frozen lockfile.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first (cached until pyproject.toml or uv.lock change), then the package itself.
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-install-project --extra ui
COPY src ./src
RUN uv sync --frozen --no-dev --extra ui
# The API offers the bundled examples as jobs (12 §1.2); it reads their manifests from here.
COPY examples ./examples

RUN useradd --system --create-home --uid 10001 qscore \
    && mkdir -p /var/lib/qscore && chown qscore:qscore /var/lib/qscore
USER qscore
ENV PATH="/app/.venv/bin:$PATH" \
    QSCORE_CACHE_DIR=/home/qscore/.qscore \
    QSCORE_PLATFORM_DB_PATH=/var/lib/qscore/platform.sqlite3

EXPOSE 8080
# Platform API; Caddy removes the public /api prefix.
CMD ["uvicorn", "qscore.api.app:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
