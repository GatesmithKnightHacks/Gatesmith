    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemPlan"
      },
      "title": "Items",
      "type": "array"
    },
    "memory_mode": {
      "enum": [
        "model_loaded",
        "exclusive"
      ],
      "title": "Memory Mode",
      "type": "string"
    },
    "schema": {
      "const": "qscore.plan/v0.2",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "items",
    "memory_mode",
    "hardware_profile_id"
  ],
  "title": "Plan",
  "type": "object"
