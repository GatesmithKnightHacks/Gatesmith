# Gatesmith worker settings — template. Copy to `.env.worker` (git ignores it) and fill in.
# Never commit a filled copy, paste it into chat, or put it in a notebook cell's output.
#
# Used by the queue worker (`python -m qscore.worker`, qscore/docs/deployment.md §3.2) on the AMD
# notebook or a laptop. The Vultr server has its own template: qscore/docker/env.example.
#
# Load it into the shell, then start the worker from the qscore/ folder:
#   cd qscore
#   set -a; . ../.env.worker; set +a
#   uv run python -m qscore.worker
#
# Keep the single quotes: the connection string contains `&` and the capabilities contain spaces.

# Neon connection for the qscore_worker role, production branch, DIRECT host (no "-pooler").
# Ask the deployment owner for the password; each person gets their own copy privately.
QSCORE_NEON_DSN='postgresql://qscore_worker:<password>@<direct-host>/neondb?sslmode=require&channel_binding=require'

# What this machine offers (required until the hardware profiler exists).
#   AMD notebook: '{"gpu": true, "neon_write": true}'  (turns on the website's GPU-online light)
#   Laptop:       '{"gpu": false, "neon_write": true}'
QSCORE_CAPABILITIES='{"gpu": true, "neon_write": true}'

# A name for this worker in the `workers` table (optional; default worker-<hostname>).
QSCORE_WORKER_ID='w7900-notebook'

# Optional: where the bundled examples live (default: this checkout's qscore/examples).
# QSCORE_EXAMPLES_DIR='/path/to/Gatesmith/qscore/examples'
