# Gatesmith HTTPS worker settings. Copy to ignored .env.worker and fill privately.
# Worker execution remains blocked until Hub publication and claim-loss cancellation are wired.
# The platform alone owns SQLite; no database credentials belong on workers.
QSCORE_PLATFORM_URL='https://<platform-host>/api'
QSCORE_WORKER_TOKEN='<per-worker-token-from-deployment-owner>'
QSCORE_WORKER_ID='w7900-notebook'
QSCORE_CAPABILITIES='{"gpu": true, "aer_gpu": true, "hub_write": true}'
QSCORE_HUB_DATASET_REPO='<owner>/qscore-runs'
# Never commit a filled file or expose tokens to the browser.
